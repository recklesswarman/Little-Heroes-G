# ============================================================
# Little Heroes AGY Microservice — Environment Variables
# Copy to .env and fill in values before running locally.
# ============================================================

# Google Gemini API key (get from https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase project ID
FIREBASE_PROJECT_ID=little-heroes-quest-8842

# Path to Firebase Admin SDK service account JSON key file
# Download from Firebase Console → Project Settings → Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Service port (default 8080 for Cloud Run)
PORT=8080

# Optional: override default AGY save_dir base path
AGY_SAVE_DIR=/tmp/agents
