# Local dev config for little-heroes-tts-service.
# This service has no required secrets -- Kokoro runs fully offline/locally,
# so there's no API key to configure (unlike the ElevenLabs/Gemini TTS tiers
# it replaces).

# Port the FastAPI/uvicorn server listens on. Cloud Run sets this
# automatically in production; only needed for local runs.
PORT=8080

# Set to "development" to enable uvicorn auto-reload when running locally.
ENVIRONMENT=development
