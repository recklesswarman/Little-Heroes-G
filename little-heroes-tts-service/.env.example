# Local dev config for little-heroes-tts-service.
# This service has no required secrets -- Kokoro runs fully offline/locally,
# so there's no API key to configure (unlike the ElevenLabs/Gemini TTS tiers
# it replaces).

# Port the FastAPI/uvicorn server listens on. Cloud Run sets this
# automatically in production; only needed for local runs.
PORT=8080

# Set to "development" to enable uvicorn auto-reload when running locally.
ENVIRONMENT=development

# Skip loading + warming the model at startup (faster local boot when you
# only need to hit /health or /voices).
# SKIP_WARMUP=1

# Override the auto-detected PyTorch thread count (defaults to the container's
# CPU quota on Cloud Run).
# TORCH_NUM_THREADS=4

# Extra comma-separated browser origins allowed by CORS, on top of the
# built-in localhost / web.app / github.io / App Hosting defaults.
# CORS_ORIGINS=https://preview--little-heroes-quest-8842.web.app
