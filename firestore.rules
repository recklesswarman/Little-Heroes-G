rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Security Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidHouseholdCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 32;
    }

    // Identifies whether the current authenticated user is an authorized parent admin
    function isParent(householdData) {
      return isAuthenticated() && (
        ('parentUids' in householdData && householdData.parentUids is list && request.auth.uid in householdData.parentUids) ||
        ('parentEmails' in householdData && householdData.parentEmails is list && request.auth.token.email != null && request.auth.token.email in householdData.parentEmails)
      );
    }

    // One-time bootstrap: a household created without parents yet can have the
    // first authenticated caller claim ownership, but ONLY via an update that
    // itself sets parentUids to include their own uid. This closes the
    // loophole immediately after the first claim instead of treating every
    // authenticated user as a parent forever whenever parentUids is empty.
    function isBootstrapParentClaim(householdData) {
      return isAuthenticated()
        && (!('parentUids' in householdData) || !(householdData.parentUids is list) || householdData.parentUids.size() == 0)
        && request.resource.data.parentUids is list
        && request.auth.uid in request.resource.data.parentUids;
    }

    // Validates household payload structure and limits resource exhaustion
    function isValidHouseholdPayload() {
      let data = request.resource.data;
      return (data.keys().hasAny(['syncCode', 'name', 'householdName']))
        && (!('syncCode' in data) || (data.syncCode is string && data.syncCode.size() <= 32))
        && (!('householdName' in data) || (data.householdName is string && data.householdName.size() <= 100))
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('devices' in data) || (data.devices is map && data.devices.size() <= 25))
        && (!('heroes' in data) || (data.heroes is list && data.heroes.size() <= 20))
        && (!('heroesMap' in data) || (data.heroesMap is map && data.heroesMap.size() <= 20))
        && (!('deletedHeroIds' in data) || (data.deletedHeroIds is list && data.deletedHeroIds.size() <= 50))
        && (!('parents' in data) || (data.parents is list && data.parents.size() <= 15))
        && (!('parentUids' in data) || (data.parentUids is list && data.parentUids.size() <= 15))
        && (!('parentEmails' in data) || (data.parentEmails is list && data.parentEmails.size() <= 15))
        && (!('pendingApprovals' in data) || (data.pendingApprovals is list && data.pendingApprovals.size() <= 100))
        && (!('taskCompletionLogs' in data) || (data.taskCompletionLogs is list && data.taskCompletionLogs.size() <= 500))
        && (!('taskForest' in data) || (data.taskForest is list && data.taskForest.size() <= 50))
        && (!('habitIslands' in data) || (data.habitIslands is list && data.habitIslands.size() <= 50))
        && (!('aiQuests' in data) || (data.aiQuests is list && data.aiQuests.size() <= 50))
        && (!('recentlyUnlocked' in data) || (data.recentlyUnlocked is list && data.recentlyUnlocked.size() <= 50))
        && (!('parentSettings' in data) || (data.parentSettings is map && data.parentSettings.size() <= 30));
    }

    // Kids CANNOT change a hero's reward balances directly through heroesMap.
    // Existing hero entries must keep identical reward-bearing fields; a
    // newly-added hero entry must start at zero.
    function heroRewardFieldsLocked(existingData, newData) {
      let oldMap = ('heroesMap' in existingData && existingData.heroesMap is map) ? existingData.heroesMap : {};
      let newMap = ('heroesMap' in newData && newData.heroesMap is map) ? newData.heroesMap : {};
      return newMap.keys().all(id,
        !(id in oldMap)
          ? (
              (!('points' in newMap[id]) || newMap[id].points == 0) &&
              (!('coins' in newMap[id]) || newMap[id].coins == 0) &&
              (!('tokens' in newMap[id]) || newMap[id].tokens == 0) &&
              (!('xp' in newMap[id]) || newMap[id].xp == 0)
            )
          : (
              (!('points' in oldMap[id]) || !('points' in newMap[id]) || newMap[id].points == oldMap[id].points) &&
              (!('coins' in oldMap[id]) || !('coins' in newMap[id]) || newMap[id].coins == oldMap[id].coins) &&
              (!('tokens' in oldMap[id]) || !('tokens' in newMap[id]) || newMap[id].tokens == oldMap[id].tokens) &&
              (!('xp' in oldMap[id]) || !('xp' in newMap[id]) || newMap[id].xp == oldMap[id].xp) &&
              (!('level' in oldMap[id]) || !('level' in newMap[id]) || newMap[id].level == oldMap[id].level) &&
              (!('streak' in oldMap[id]) || !('streak' in newMap[id]) || newMap[id].streak == oldMap[id].streak) &&
              (!('stars' in oldMap[id]) || !('stars' in newMap[id]) || newMap[id].stars == oldMap[id].stars)
            )
      );
    }

    // Strict validation for kid/non-parent updates:
    // Kids CANNOT touch parentSettings, parent admin lists, delete kid profiles, approve tasks, or manipulate point balances
    function isAllowedKidChoreUpdate(existingData, newData) {
      let affected = newData.diff(existingData).affectedKeys();
      return isValidHouseholdPayload()
        // 1. Kids CANNOT modify parental controls, parent admin user lists, or delete profiles
        && !affected.hasAny(['parentSettings', 'parents', 'parentUids', 'parentEmails', 'deletedHeroIds'])
        // 2. Kids CANNOT dismiss, delete, edit, or mark existing pending approvals as approved --
        //    every existing entry must still be present, byte-for-byte, in the new list
        && (!('pendingApprovals' in existingData) || existingData.pendingApprovals.all(item,
              ('pendingApprovals' in newData) && (item in newData.pendingApprovals)))
        // 3. Kids CANNOT delete or rewrite completion logs, only append new ones
        && (!('taskCompletionLogs' in existingData) || existingData.taskCompletionLogs.all(item,
              ('taskCompletionLogs' in newData) && (item in newData.taskCompletionLogs)))
        // 4. Kids CANNOT self-award points/coins/xp/level/streak via the heroesMap
        && heroRewardFieldsLocked(existingData, newData);
    }

    // --- Households Collection ---
    // Multi-device family synchronization scoped to explicit household codes
    match /households/{householdCode} {
      // Allow read with valid household code syntax
      allow read: if isValidHouseholdCode(householdCode);
      
      // Allow creation of a valid household payload
      allow create: if isValidHouseholdCode(householdCode)
        && isValidHouseholdPayload();

      // Updates:
      // Parents can update any aspect (approvals, points, coins, settings, co-parents).
      // Kids can only submit chores with isAllowedKidChoreUpdate().
      allow update: if isValidHouseholdCode(householdCode) && (
        isParent(resource.data) ||
        isBootstrapParentClaim(resource.data) ||
        isAllowedKidChoreUpdate(resource.data, request.resource.data)
      );

      // Prevent malicious household deletion from client
      allow delete: if false;
    }

    // --- Users / Hero Profiles Collection (unused by the client app) ---
    // No code in this app reads or writes /users/{heroId} -- it is legacy
    // surface with no ownership model. Deny client access entirely rather
    // than leave a reachable, unscoped collection open to any authenticated
    // (including anonymous) Firebase client on this project.
    match /users/{heroId} {
      allow read, write: if false;

      match /{allChildren=**} {
        allow read, write: if false;
      }
    }

    // --- Heroes Collection & Companion Settings (server-only) ---
    // Written exclusively by Cloud Functions via the Admin SDK, which
    // bypasses these rules. No client code reads or writes this collection
    // directly, so client access is denied entirely to prevent a malicious
    // client from hijacking a hero's parentUid or corrupting reward data
    // (xp/coins/streak) that verifyChoreSubmission increments server-side.
    match /heroes/{heroId} {
      allow read, write: if false;

      match /{allChildren=**} {
        allow read, write: if false;
      }
    }

    // --- User Household Persistent Links ---
    // Scoped strictly to authenticated users managing their household associations
    match /user_households/{linkId} {
      // User can only access their own user link or matching email link
      allow read: if isAuthenticated() && (
        request.auth.uid == linkId || 
        (request.auth.token.email != null && linkId.matches('email_.*'))
      );
      
      allow create, update: if isAuthenticated() && (
        request.auth.uid == linkId || 
        (request.auth.token.email != null && linkId.matches('email_.*'))
      ) && request.resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated() && request.auth.uid == linkId;
    }

    // --- Zero-Trust Default Deny ---
    // Disallow all other collections and unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
