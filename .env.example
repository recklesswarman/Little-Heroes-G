VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
CLOUDFLARE_IMAGE_API_URL=
# Origin the server sends to the Worker allow-list (default: the .web.app site)
CLOUDFLARE_IMAGE_ORIGIN=
VITE_IMAGE_GEN_API_URL=

# Rex voice lab (/voice-lab.html): whisper.cpp + Piper running on the family Pi.
# whisper.cpp `whisper-server` base URL (POST /inference), base.en model on the Pi
WHISPER_CPP_URL=http://127.0.0.1:8178
WHISPER_LANGUAGE=en
# Piper HTTP server. The Pi serves POST /synthesize {"text"} -> WAV (en_US-lessac-medium).
# PIPER_MODE=get is for the older GET <path>?text= style server.
PIPER_URL=http://127.0.0.1:5000
PIPER_PATH=/synthesize
PIPER_MODE=post-json
PIPER_VOICE=

# Optional: play a downloaded LottieFiles animation instead of the bundled public/lottie/*.json
VITE_LOTTIE_CONFETTI_URL=
VITE_LOTTIE_TROPHY_URL=
VITE_LOTTIE_COINS_URL=

# Parent alerts through the Pi's ntfy server (subscribe to the topic in the ntfy app).
# "pi-alerts" is already used by the Pi's own alerts, so keep the app on its own topic.
NTFY_URL=http://127.0.0.1:8090
NTFY_TOPIC=little-heroes
NTFY_TOKEN=
NTFY_ENABLED=true
# Set to false on a device that shouldn't send parent alerts
VITE_PARENT_NOTIFY=true
# Rex's everyday voice on the Pi (/api/local/*) reuses PIPER_URL and WHISPER_CPP_URL above;
# PIPER_TTS_URL / WHISPER_URL override them if set.
